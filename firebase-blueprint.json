{
  "entities": {
    "Map": {
      "title": "Map",
      "description": "Collaborative map instance containing category scheme and metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 100 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "ownerEmail": { "type": "string", "maxLength": 128 },
        "ownerDisplayName": { "type": "string", "maxLength": 100 },
        "categories": { "type": "string", "description": "Serialized categories array with id, name, and color hex" },
        "collaboratorIds": { "type": "string", "description": "Serialized user IDs of participants" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "ownerId", "ownerEmail", "createdAt", "updatedAt"]
    },
    "Categorization": {
      "title": "Categorization",
      "description": "A user's specific country assignments for a map",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "mapId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "userEmail": { "type": "string", "maxLength": 128 },
        "assignments": { "type": "string", "description": "Serialized JSON mapping countryId to categoryId" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "mapId", "userId", "updatedAt"]
    },
    "CountryNote": {
      "title": "CountryNote",
      "description": "A note attached to a country on a map, created by a specific user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "mapId": { "type": "string", "maxLength": 128 },
        "countryId": { "type": "string", "maxLength": 32 },
        "countryName": { "type": "string", "maxLength": 100 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorEmail": { "type": "string", "maxLength": 128 },
        "content": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "mapId", "countryId", "authorId", "content", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/maps/{mapId}": {
      "schema": { "$ref": "Map" },
      "description": "Shared world map configuration and category schemes"
    },
    "/maps/{mapId}/categorizations/{userId}": {
      "schema": { "$ref": "Categorization" },
      "description": "Each user's individual country categorizations for the map"
    },
    "/maps/{mapId}/notes/{noteId}": {
      "schema": { "$ref": "CountryNote" },
      "description": "Collaborator notes attached to countries on the map"
    }
  }
}
