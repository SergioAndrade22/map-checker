rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    match /maps/{mapId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(mapId) && incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && (
        existing().ownerId == request.auth.uid ||
        incoming().diff(existing()).affectedKeys().hasOnly(['collaboratorIds', 'updatedAt'])
      );
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;

      match /categorizations/{userId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn() && isValidId(userId) && userId == request.auth.uid && incoming().userId == request.auth.uid;
        allow update: if isSignedIn() && userId == request.auth.uid && incoming().userId == request.auth.uid;
        allow delete: if isSignedIn() && userId == request.auth.uid;
      }

      match /notes/{noteId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn() && isValidId(noteId) && incoming().authorId == request.auth.uid;
        allow update: if isSignedIn() && existing().authorId == request.auth.uid && incoming().authorId == request.auth.uid;
        allow delete: if isSignedIn() && existing().authorId == request.auth.uid;
      }
    }
  }
}
